# App Port
PORT=5000

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/food_delivery_db

# Redis Configuration (Docker Local)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Meilisearch Configuration (Docker Local)
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=masterKey_fod_meilisearch_123456

# RabbitMQ Configuration (Docker Local)
RABBITMQ_URL=amqp://admin:admin123@127.0.0.1:5672

# JWT Secrets
JWT_SECRET=your_super_secret_jwt_key
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key

# Email SMTP (Nodemailer)
USER_EMAIL=your_email@gmail.com
USER_PASS=your_app_password

# AWS S3 Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY=your_aws_access_key
AWS_SECRET_KEY=your_aws_secret_key
BUCKET_NAME=your_s3_bucket_name

# VNPay Payment Gateway
VNPAY_TMN_CODE=
VNPAY_SECRET_KEY=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_CHECK_PAYMENT=http://localhost:3000/payment-result

# Python AI Service (Recommendation)
PYTHON_API_URL=http://localhost:8000
PYTHON_RECOMMEND_URL=http://localhost:8000
